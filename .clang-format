Language: Cpp
# BasedOnStyle:  LLVM
# Offset for access specifiers (public, private, etc.)
AccessModifierOffset: -4
# Alignment after open brackets (paren, angle, square)
AlignAfterOpenBracket: Align
# Align '=' on consecutive assignments
AlignConsecutiveAssignments: false
# Align variable names on consecutive declarations
AlignConsecutiveDeclarations: false
# Left-align escaped newlines (backslashes at line continuations)
AlignEscapedNewlinesLeft: true
# Horizontally align operands of binary and ternary expressions
AlignOperands: true
# Align consecutive trailing comments
AlignTrailingComments: true
# Allow placing all parameters of a function declaration on the next line
AllowAllParametersOfDeclarationOnNextLine: false
# Allow short blocks on a single line
AllowShortBlocksOnASingleLine: false
# Allow short case labels on a single line
AllowShortCaseLabelsOnASingleLine: false
# Allow short functions on a single line: None, InlineOnly (defined in class), Empty (empty bodies), Inline, All
AllowShortFunctionsOnASingleLine: Empty
# Allow short if statements on a single line
AllowShortIfStatementsOnASingleLine: false
# Allow short loops on a single line
AllowShortLoopsOnASingleLine: false
# Always break after the function definition's return type (deprecated)
AlwaysBreakAfterDefinitionReturnType: None
# Always break after the return type: None, All, TopLevel (top-level functions, not members),
#   AllDefinitions (all definitions, not declarations), TopLevelDefinitions (only top-level definitions)
AlwaysBreakAfterReturnType: None
# Always break before multi-line string literals
AlwaysBreakBeforeMultilineStrings: true
# Always break after template declarations
AlwaysBreakTemplateDeclarations: true
# false: function arguments are either all on the same line or each on its own line
BinPackArguments: true
# false: function parameters are either all on the same line or each on its own line
BinPackParameters: false
# Brace wrapping rules, used only when BreakBeforeBraces is Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: false
  AfterObjCDeclaration: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
# Break before binary operators: None (break after), NonAssignment (break before non-assignment ops), All
BreakBeforeBinaryOperators: None
# Brace placement: Attach (always attach to surrounding context), Linux (Attach except for funcs/namespaces/classes),
#   Mozilla (Attach except enums/funcs/records), Stroustrup (Attach except func defs, catch, else),
#   Allman (always break before braces), GNU (always break and indent for control statements),
#   WebKit (break before function), Custom.
#   Note: a brace-delimited block here is treated as a function body too.
BreakBeforeBraces: Custom
# Break before ternary operators
BreakBeforeTernaryOperators: true
# Break before the comma in the constructor initializer list
BreakConstructorInitializersBeforeComma: false
# Max characters per line, 0 means no limit
ColumnLimit: 120
# Regex for comments with special meaning — they must not be split or otherwise altered
CommentPragmas: "^ IWYU pragma:"
# Constructor initializer list: all on one line, or one per line
ConstructorInitializerAllOnOneLineOrOnePerLine: true
# Indent width for the constructor initializer list
ConstructorInitializerIndentWidth: 4
# Continuation indent width
ContinuationIndentWidth: 4
# Remove spaces after { and before } in C++11 braced initializer lists
Cpp11BracedListStyle: true
# Infer the most common pointer/reference alignment
DerivePointerAlignment: false
# Disable formatting
DisableFormat: false
# Auto-detect whether function calls/definitions are formatted one parameter per line (experimental)
ExperimentalAutoDetectBinPacking: false
# Macros that should be interpreted as foreach loops rather than function calls
ForEachMacros: [foreach, Q_FOREACH, BOOST_FOREACH]
# Sort #include directives; matched regexes get the given priority. Unmatched defaults to INT_MAX
# (lower priority sorts earlier). Negative priorities can force certain includes to the very top.
IncludeCategories:
  - Regex: '^"(llvm|llvm-c|clang|clang-c)/'
    Priority: 2
  - Regex: '^(<|"(gtest|isl|json)/)'
    Priority: 3
  - Regex: ".*"
    Priority: 1
# Indent case labels
IndentCaseLabels: true
# Indent width
IndentWidth: 4
# When the function return type wraps, indent the function name
IndentWrappedFunctionNames: true
# Keep empty lines at the start of a block
KeepEmptyLinesAtTheStartOfBlocks: true
# Regex matching macros that start a block
MacroBlockBegin: ""
# Regex matching macros that end a block
MacroBlockEnd: ""
# Maximum number of consecutive empty lines to keep
MaxEmptyLinesToKeep: 1
# Namespace indentation: None, Inner (indent only nested namespaces), All
NamespaceIndentation: None
# Indent width for ObjC blocks
ObjCBlockIndentWidth: 4
# Add a space after @property in ObjC
ObjCSpaceAfterProperty: false
# Add a space before the ObjC protocol list
ObjCSpaceBeforeProtocolList: true
# Penalty for breaking before the first call parameter at call(
PenaltyBreakBeforeFirstCallParameter: 19
# Penalty for introducing a newline inside a comment
PenaltyBreakComment: 300
# Penalty for the first line break before <<
PenaltyBreakFirstLessLess: 120
# Penalty for introducing a newline inside a string literal
PenaltyBreakString: 1000
# Penalty per character beyond the column limit
PenaltyExcessCharacter: 1000000
# Penalty for placing the return type on its own line
PenaltyReturnTypeOnItsOwnLine: 6000
# Pointer/reference alignment: Left, Right, Middle
PointerAlignment: Left
# Allow reflowing of comments
ReflowComments: true
# Sort #include directives
SortIncludes: false
# Add a space after C-style casts
SpaceAfterCStyleCast: false
# Add a space before assignment operators
SpaceBeforeAssignmentOperators: true
# Space before open paren: Never, ControlStatements, Always
SpaceBeforeParens: ControlStatements
# Add a space in empty parentheses
SpaceInEmptyParentheses: false
# Spaces before trailing comments (only applies to //)
SpacesBeforeTrailingComments: 1
# Add spaces inside angle brackets after < and before >
SpacesInAngles: false
# Add spaces in container (ObjC/JS array and dict) literals
SpacesInContainerLiterals: true
# Add spaces in C-style cast parentheses
SpacesInCStyleCastParentheses: false
# Add spaces after ( and before ) in parentheses
SpacesInParentheses: false
# Add spaces after [ and before ] in square brackets (lambdas and unspecified-size arrays unaffected)
SpacesInSquareBrackets: false
# C++ standard: Cpp03, Cpp11, Auto
Standard: Cpp11
# Tab width
TabWidth: 4
# Use tab characters: Never, ForIndentation, ForContinuationAndIndentation, Always
UseTab: Never
# Align consecutive macro definitions
AlignConsecutiveMacros: true
